# --- Runtime data dirs (user content / search index / podman volumes) ---
# Lucene rebuilds from messages on startup; uploads + avatars are user-owned
# and should be backed up out-of-band, not committed.
data/
podman-data/

# --- Secrets / local config ---
*.env
.env
.env.*
!.env.example
application-local.yml
application-local.properties
application-dev.properties
application-secret.yml
application-secret.properties
*.pem
*.key
*.p12
*.jks
*.keystore

# --- Testcontainers / temp ---
.testcontainers.properties
*.tmp
*.bak
*.swp
*~

# --- Claude Code / agent state ---
# Per-project agent memory + runtime metadata. Personal to whoever drove the
# session; project-wide docs that should be shared belong in CLAUDE.md.
.claude/
MEMORY.md

# Local compose override (LAN/mobile testing) — see compose.override.yml.example
compose.override.yml
