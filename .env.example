# IntelliStream Chat — every environment variable the application reads.
#
# Copy to a private env file and change what you need. Everything here is optional except the
# database and Keycloak credentials at the top; the value shown after each name is the built-in
# default, so a line you delete behaves exactly as the line you left commented.
#
# Load it however your deploy expects:
#   systemd    EnvironmentFile=/etc/intellistream-chat/env    (see QUICKSTART-MANUAL.md)
#   container  docker/podman run --env-file .env ...
#   shell      set -a; . ./.env; set +a     before ./gradlew bootRun
# Spring Boot does not auto-load a .env file; this is a template for the mechanisms above.
#
# systemd parses this file itself: no quoting, no $ expansion, no trailing comments after a value.
#
# Every name here maps to a dotted property — ICHAT_WS_INBOUND_THREADS is ichat.ws.inbound-threads
# — through Spring's relaxed binding, so anything documented in the manual as a property can be set
# here even when it is not listed in application.yml. The reverse also works: pass it as
# -Dichat.ws.inbound-threads=48 in JAVA_OPTS if you prefer.
#
# Vault/OpenBao carries credentials only (the five keys at the bottom), not tuning.

# =============================================================================================
# Required
# =============================================================================================

# --- Database (Postgres) ---
ICHAT_DB_URL=jdbc:postgresql://localhost:5432/intellistream_chat
ICHAT_DB_USERNAME=ichat_role
ICHAT_DB_PASSWORD=CHANGE-ME

# --- Keycloak / OIDC ---
KEYCLOAK_ISSUER_URI=https://auth.your-domain/realms/ichat-realm
KEYCLOAK_CLIENT_ID=ichat-client
# No default: the app refuses to build its web filter chain without this, because an empty secret
# turns every login into /login?error at the token exchange. Rotate the bundled dev secret first.
KEYCLOAK_CLIENT_SECRET=CHANGE-ME

# =============================================================================================
# HTTP
# =============================================================================================

# Loopback by default, which is right behind a TLS-terminating proxy and safe if you forget.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# WebSocket handshake origin allow-list (CSWSH defence). Set this to your real origin in
# production — a handshake from anywhere else is refused, and the page loads fine while only the
# live updates break, which is a confusing way to find out.
# ICHAT_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# =============================================================================================
# Storage
# =============================================================================================

# All four should sit under the single ReadWritePaths= of the systemd unit.
ICHAT_ATTACHMENTS_DIR=./data/attachments
ICHAT_AVATARS_DIR=./data/avatars
ICHAT_BRANDING_DIR=./data/branding
ICHAT_SEARCH_LUCENE_DIR=./data/lucene

# Total bytes one account may store (2 GiB). Negative means unlimited. There is no per-file cap,
# so this total is what decides the largest single file an ordinary account can send; admins are
# exempt from it entirely.
# ICHAT_USER_QUOTA_BYTES=2147483648

# Refuse uploads while the attachments filesystem has less than this free (64 MiB), leaving the
# last of the disk for Postgres and Lucene merges. Zero disables the check.
# ICHAT_MIN_FREE_BYTES=67108864

# =============================================================================================
# WebSocket tuning — the most load-bearing settings here
# =============================================================================================

# 0 means cores x 4. Aim for roughly the size of the database pool it feeds; threads beyond that
# just queue inside Hikari. A startup line logs the executors actually resolved — check it before
# trusting any throughput number.
# ICHAT_WS_INBOUND_THREADS=0
# ICHAT_WS_OUTBOUND_THREADS=0
# ICHAT_WS_INBOUND_QUEUE=100000
# ICHAT_WS_OUTBOUND_QUEUE=200000

# Size to your channel count. Spring's broker caches destination->subscriber mappings with a stock
# limit of 1024; past that every broadcast rescans every subscription, which at 2,000 rooms and
# 100,000 connections was 47% of server CPU and half the traffic dropped. It looks exactly like an
# under-provisioned machine, so check this before blaming hardware.
# ICHAT_WS_SUBSCRIPTION_CACHE_LIMIT=16384

# Per-session buffers. Lowering them is how the per-connection memory figures in scalability.md
# were measured; leave them alone unless you are chasing a connection-count record.
# ICHAT_WS_BINARY_BUFFER_BYTES=8192
# ICHAT_WS_SOCKET_BUFFER_BYTES=8192

# =============================================================================================
# Write-behind message batching
# =============================================================================================

# Ids are pre-allocated and rows inserted in batches a few ms later, sharded by channel so
# per-channel order holds. A message is broadcast and indexed only after its batch commits.
# ICHAT_WRITE_BEHIND_ENABLED=true
# ICHAT_WRITE_BEHIND_BATCH_SIZE=256
# ICHAT_WRITE_BEHIND_FLUSH_INTERVAL_MS=5
# ICHAT_WRITE_BEHIND_FLUSH_THREADS=4
# ICHAT_WRITE_BEHIND_BROADCAST_THREADS=8
# ICHAT_WRITE_BEHIND_QUEUE_CAPACITY=100000
# ICHAT_WRITE_BEHIND_ID_BLOCK_SIZE=4096

# =============================================================================================
# Search (embedded Lucene)
# =============================================================================================

# ICHAT_SEARCH_ASYNC_INDEXING=true
# ICHAT_SEARCH_FLUSH_INTERVAL_MS=250

# =============================================================================================
# Caches, presence, rate limiting
# =============================================================================================

# Channel access decisions. Only positive decisions are cached; a leave, kick, rename or archive
# evicts explicitly.
# ICHAT_CACHE_CHANNEL_TTL_SECONDS=60
# ICHAT_CACHE_MAX_ENTRIES=100000

# Idle minutes before a connected user is shown as away. A manual Away/DND/Offline override is
# never cleared by activity.
# ICHAT_PRESENCE_AWAY_AFTER_MINUTES=10

# Per-user sliding-window limiter, in-memory and therefore per-process. Turn it off only in a
# test rig; replace it with a distributed limiter before running more than one node.
# ICHAT_RATELIMIT_ENABLED=true

# =============================================================================================
# Moderation and retention
# =============================================================================================

# An admin removal is a soft delete: rows stay and stay recoverable until this window passes, then
# RetentionPurgeScheduler hard-deletes them. 0 or negative keeps removed messages forever.
# ICHAT_RETENTION_DAYS=30
# ICHAT_PURGE_ENABLED=true
# ICHAT_PURGE_INTERVAL_MS=3600000
# ICHAT_PURGE_INITIAL_DELAY_MS=600000
# ICHAT_MODERATION_PURGE_BATCH_SIZE=500
# ICHAT_MODERATION_PURGE_MAX_BATCHES=200

# Mirror a suspension into Keycloak (disable the user there too). Off by default because it needs
# admin credentials against your identity provider.
# ICHAT_MODERATION_KEYCLOAK_WRITETHROUGH_ENABLED=false
# ICHAT_MODERATION_KEYCLOAK_WRITETHROUGH_SERVER_URL=
# ICHAT_MODERATION_KEYCLOAK_WRITETHROUGH_TIMEOUT_MILLIS=5000

# =============================================================================================
# Cleanup sweeps (orphaned files, Lucene reconcile)
# =============================================================================================

# dry-run is TRUE by default: the sweeps log what they would delete and delete nothing. Watch the
# log until you believe the backlog, then set it false to arm the destructive half.
# ICHAT_CLEANUP_ENABLED=true
# ICHAT_CLEANUP_DRY_RUN=true
# ICHAT_CLEANUP_GRACE=24h
# ICHAT_CLEANUP_FILE_SWEEP_MS=3600000
# ICHAT_CLEANUP_RECONCILE_MS=3600000
# ICHAT_CLEANUP_INITIAL_DELAY_MS=300000

# @EnableScheduling runs on every node, so the sweeps and the purge race across a cluster. Leave
# them enabled on exactly one node until that is fixed.

# =============================================================================================
# Branding, reminders, assets, dev tools
# =============================================================================================

# Shown in the browser tab and the top bar. The admin console writes it at runtime; this is the
# value used before anyone sets one.
# ICHAT_BRANDING_TITLE=IntelliStream Chat

# How often the reminder scheduler looks for due reminders.
# ICHAT_REMINDERS_POLL_MS=30000

# Fallback timezone for users with no profile setting and no zoneinfo claim from the IdP. Decides
# what "/remind me at 09:00" means. Empty means the JVM's own zone.
# ICHAT_DEFAULT_ZONE=

# false serves the minified, hash-versioned bundles (production). true serves raw sources so an
# edit shows on refresh — the dev profile sets this.
ICHAT_ASSETS_UNBUNDLED=false

# Loads the in-browser smoke runner (runTests() in the console). Never enable in production.
# ICHAT_DEV_TOOLS_ENABLED=false

# =============================================================================================
# Optional: Vault / OpenBao
# =============================================================================================

# Credentials only. The processor reads secret/data/${path} and maps exactly five keys —
# db.username, db.password, keycloak.client-id, keycloak.client-secret, keycloak.issuer-uri —
# into their Spring property names before anything consumes them. Any other key in the record is
# ignored on purpose, so tuning stays here in the env file.
# ICHAT_VAULT_ENABLED=false
# ICHAT_VAULT_URI=
# ICHAT_VAULT_TOKEN=
# ICHAT_VAULT_PATH=intellistream-chat

# =============================================================================================
# JVM (read by the systemd unit, not by the application)
# =============================================================================================

# JAVA_OPTS=-Xms256m -Xmx2g -XX:+UseZGC -XX:+ExitOnOutOfMemoryError --enable-native-access=ALL-UNNAMED
