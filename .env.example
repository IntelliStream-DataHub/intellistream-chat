# IntelliStream Chat environment variables — copy to a private env file and fill in.
#
# Every value below overrides an application.yml default. Load it however your deploy expects:
#   - systemd:   EnvironmentFile=/etc/intellistream-chat/intellistream-chat.env   (see QUICKSTART-MANUAL.md)
#   - container: docker/podman run --env-file .env ...
#   - shell:     `set -a; . ./.env; set +a` before ./gradlew bootRun
# (Spring Boot does not auto-load a .env file; this is a template for the mechanisms above.)

# --- Database (Postgres) ---
ICHAT_DB_URL=jdbc:postgresql://localhost:5432/intellistream_chat
ICHAT_DB_USERNAME=ichat_role
ICHAT_DB_PASSWORD=CHANGE-ME

# --- Keycloak / OIDC ---
KEYCLOAK_ISSUER_URI=https://auth.your-domain/realms/ichat-realm
KEYCLOAK_CLIENT_ID=ichat-client
# No default in the prod profile — the app fails fast if this is unset. Rotate the bundled dev
# secret in Keycloak and put the new value here.
KEYCLOAK_CLIENT_SECRET=CHANGE-ME

# --- HTTP (bind loopback behind a TLS-terminating proxy) ---
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# --- Runtime data directories ---
ICHAT_ATTACHMENTS_DIR=./data/attachments
ICHAT_AVATARS_DIR=./data/avatars
ICHAT_BRANDING_DIR=./data/branding
ICHAT_SEARCH_LUCENE_DIR=./data/lucene

# --- Assets: false = serve minified bundles (prod default), true = serve raw sources (dev) ---
ICHAT_ASSETS_UNBUNDLED=false

# --- Scheduled cleanup sweeps (orphan files + Lucene reconcile). dry-run logs only by default. ---
# ICHAT_CLEANUP_ENABLED=true
# ICHAT_CLEANUP_DRY_RUN=true

# --- Optional Vault / OpenBao secret backend (off by default) ---
# ICHAT_VAULT_ENABLED=false
# ICHAT_VAULT_URI=
# ICHAT_VAULT_TOKEN=
# ICHAT_VAULT_PATH=intellistream-chat
