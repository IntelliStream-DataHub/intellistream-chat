# ThreadOrbit environment variables — copy to a private env file and fill in.
#
# Every value below overrides an application.yml default. Load it however your deploy expects:
#   - systemd:   EnvironmentFile=/etc/threadorbit/threadorbit.env   (see QUICKSTART-MANUAL.md)
#   - container: docker/podman run --env-file .env ...
#   - shell:     `set -a; . ./.env; set +a` before ./gradlew bootRun
# (Spring Boot does not auto-load a .env file; this is a template for the mechanisms above.)

# --- Database (Postgres) ---
THREADORBIT_DB_URL=jdbc:postgresql://localhost:5432/threadorbit_chat
THREADORBIT_DB_USERNAME=threadorbit
THREADORBIT_DB_PASSWORD=CHANGE-ME

# --- Keycloak / OIDC ---
KEYCLOAK_ISSUER_URI=https://auth.your-domain/realms/threadorbit
KEYCLOAK_CLIENT_ID=threadorbit
# No default in the prod profile — the app fails fast if this is unset. Rotate the bundled dev
# secret in Keycloak and put the new value here.
KEYCLOAK_CLIENT_SECRET=CHANGE-ME

# --- HTTP (bind loopback behind a TLS-terminating proxy) ---
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# --- Runtime data directories ---
THREADORBIT_ATTACHMENTS_DIR=./data/attachments
THREADORBIT_AVATARS_DIR=./data/avatars
THREADORBIT_BRANDING_DIR=./data/branding
THREADORBIT_SEARCH_LUCENE_DIR=./data/lucene

# --- Assets: false = serve minified bundles (prod default), true = serve raw sources (dev) ---
THREADORBIT_ASSETS_UNBUNDLED=false

# --- Scheduled cleanup sweeps (orphan files + Lucene reconcile). dry-run logs only by default. ---
# THREADORBIT_CLEANUP_ENABLED=true
# THREADORBIT_CLEANUP_DRY_RUN=true

# --- Optional Vault / OpenBao secret backend (off by default) ---
# THREADORBIT_VAULT_ENABLED=false
# THREADORBIT_VAULT_URI=
# THREADORBIT_VAULT_TOKEN=
# THREADORBIT_VAULT_PATH=threadorbit
